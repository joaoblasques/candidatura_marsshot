# Copy to .env for local development. Never commit real secrets.

# Operator acknowledgment: in v1.0, forwarded thread content is processed by an
# external LLM (Claude) and briefly stored. The app refuses to start unless this
# is explicitly set to true. See KTD5 in the plan.
NORA_EXTERNAL_LLM_ACK=false

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Outbound transport: "resend" or "postmark" (both send from the brand domain
# with domain DKIM; From = <local-part>@NORA_ADDRESS_DOMAIN), or "smtp" (local
# demo / Gmail; static From).
NORA_TRANSPORT=postmark

# Drafting backend: "anthropic" (default, prod), "ollama" (local model, DEV-ONLY), or
# "openrouter" (OpenAI-compatible cloud, dev/demo — free/cheap models when no Anthropic key).
# Non-anthropic backends are rejected at boot with a production transport (resend/postmark).
NORA_DRAFTING_BACKEND=anthropic
# OpenRouter (drafting_backend / nl_interpreter_backend = "openrouter"). One key + model
# powers both. Free models work (e.g. ...:free); structured output degrades gracefully.
# NORA_NL_INTERPRETER_BACKEND=openrouter   # plain-language front-end via OpenRouter too
# OPENROUTER_API_KEY=sk-or-...
NORA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NORA_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
NORA_OPENROUTER_TIMEOUT=60

# Calendar hold action backend; "none" = disabled; real Google backend not available yet.
NORA_CALENDAR_BACKEND=none
# Web-research backend (FI/I); "none" = disabled (NullResearchClient — default-off).
NORA_RESEARCH_BACKEND=none
# In-tenant draft backend (R2); "none" = disabled (NullTenantDraftClient — default-off).
NORA_TENANT_BACKEND=none
# Local in-boundary drafting backend for R3 relationships; "none" = disabled (R3 declines),
# "ollama" = R3 producing intents draft on local hardware (ollama_* below). Separate from
# NORA_DRAFTING_BACKEND (R1 keeps Claude), so this does NOT trip the dev-only boot guard.
NORA_LOCAL_DRAFTING_BACKEND=none
NORA_OLLAMA_BASE_URL=http://localhost:11434
NORA_OLLAMA_MODEL=qwen3:8b
NORA_OLLAMA_TIMEOUT=120

# Resend (when NORA_TRANSPORT=resend). Verify NORA_ADDRESS_DOMAIN in Resend (DNS
# DKIM/SPF records — they coexist with Cloudflare Email Routing's MX).
NORA_RESEND_API_KEY=

# SMTP transport (when NORA_TRANSPORT=smtp). Local demo: Mailpit on 127.0.0.1:1025.
# Real send without Postmark: smtp.gmail.com:587 + an app password + TLS.
NORA_SMTP_HOST=
NORA_SMTP_PORT=1025
NORA_SMTP_USERNAME=
NORA_SMTP_PASSWORD=
NORA_SMTP_USE_TLS=false

# Postmark (paid Pro for inbound parse; sender signature for outbound).
# Server token used as X-Postmark-Server-Token for outbound send.
NORA_PROVIDER_API_KEY=
# Expected HTTP Basic Auth credential ("user:password") for the inbound webhook.
# Set the same user:password in Postmark's inbound webhook URL.
NORA_WEBHOOK_BASIC_AUTH=
# Verified Postmark sender-signature address used as the outbound From.
NORA_POSTMARK_SENDER=nora@example.com
# Nora's own labeled From for consent-gated third-party sends (0.2.0 propose-meeting),
# e.g. nora@nora-bennett.com — NEVER the CEO's address. If empty, the brand
# NORA_POSTMARK_SENDER above is used, so the action From is never empty and never the CEO.
NORA_ASSISTANT_ADDRESS=

# Path to the durable send outbox (recoverable in-flight consent-gated send, KTD-D).
# Default is a gitignored local file; set an absolute path in prod if preferred.
NORA_OUTBOX_PATH=.nora-outbox.json

# Path to the durable pending-action store (pre-confirm proposals surviving restart).
NORA_PENDING_ACTION_PATH=.nora-pending-actions.json

# Per-relationship posture: JSON map of counterparty address/domain -> rung
# ("R1"/"R2"/"R3"). Unmatched defaults to R1; exact address beats domain. A relationship
# above R1 is declined on this version's external path (its content is not sent to the
# LLM). Default: all R1. Example: {"bigbank.com":"R3","vip@acme.com":"R2"}
NORA_POSTURE_MAP={}

# Cross-thread relationship memory. "none" (default, off) or "file" (per-CEO, R1-only).
#   NORA_MEMORY_BACKEND=file
#   NORA_MEMORY_PATH=.nora-memory.json   # runtime state; gitignored
# Layer C v2 (auto-learn): when on, Nora derives durable relationship facts from thread
# content on the R1 draft path and folds them into future drafts (kept separate from
# CEO-curated [remember: …] facts, framed as unconfirmed, surfaced as a "Learned:" line,
# cleared by [forget]). Default off; R1-only, fail-closed. REQUIRES NORA_MEMORY_BACKEND=file
# to persist (with "none" there's nothing to store into).
#   NORA_RELATIONSHIP_AUTOLEARN=true

# Ambient auto-draft (connected mailbox). When on, the auto-draft poller
# (scripts.autodraft_poll) watches the connected inbox and saves a reply DRAFT — never sends —
# into the owner's Drafts for genuine person-to-person mail (bulk/automated/no-reply skipped).
# Posture-gated to R1; idempotent via a Gmail label (never marks mail read). Requires
# NORA_TRANSPORT=gmail + gmail credentials. Default off.
#   NORA_AUTODRAFT=true
#   NORA_AUTODRAFT_LABEL=Nora/seen    # marks messages the poller PROCESSED (not "drafted")
# Inbox actions: forward an email to <local>+nora@ with "star and archive" (or "label as X and
# archive") and Nora applies those SAFE actions (star/archive/label/read/important — never
# trash/delete) to the original. Default off; rides the poller.
#   NORA_INBOX_ACTIONS=true
#   NORA_COMMAND_ALIAS=nora           # the +alias that marks a message as a command
# Every command also becomes a per-sender RULE (unless you say "once"); future mail from that
# sender gets the same actions + a visible Nora/filed label, and an archive-rule suppresses the
# auto-draft. "stop" removes a rule, "rules?" lists them.
#   NORA_INBOX_RULES_PATH=.nora-inbox-rules.json   # runtime state; gitignored
#   NORA_FILED_LABEL=Nora/filed
# Draft-feedback learning: if you DELETE an auto-draft (don't send it), Nora learns — after 2
# deletions she stops auto-drafting that sender (a sent draft re-enables it). Reduces-only,
# reversible. Default off.
#   NORA_DRAFT_LEARNING=true
#   NORA_DRAFT_FEEDBACK_PATH=.nora-draft-feedback.json   # runtime state; gitignored
# Gmail auth for the poller: "service_account" (Workspace + domain-wide delegation, default) or
# "oauth" for a PERSONAL @gmail.com (a service account can't impersonate a consumer account).
# For oauth: point NORA_GMAIL_OAUTH_CLIENT at your downloaded OAuth client secret, run
# `uv run python -m scripts.gmail_oauth_login` once (browser consent, gmail.modify — no send),
# then run scripts.autodraft_poll. Set NORA_GMAIL_TENANT_USER to the address (voice/memory key).
#   NORA_GMAIL_AUTH=oauth
#   NORA_GMAIL_OAUTH_CLIENT=/absolute/path/to/oauth-client.json
#   NORA_GMAIL_OAUTH_TOKEN=.nora-gmail-token.json

# Domain Nora receives at; used to build the plus-addressed Reply-To. For the
# Postmark pilot this is the inbound hash-inbox domain (default below).
NORA_ADDRESS_DOMAIN=inbound.postmarkapp.com

# Revise-loop state
NORA_STATE_TTL_SECONDS=86400
NORA_MAX_REVISE_ROUNDS=5

# Reject inbound webhook bodies larger than this many bytes before any parsing
# (defense-in-depth against oversized/abusive payloads). 0 disables the check.
# Sized to fit base64-encoded attachments (~13.3MB of files) plus the body.
NORA_MAX_INBOUND_BYTES=15000000

# Salt for the non-reversible metric identity hash (ceo_hash / thread_key). Lets the
# offline readout (scripts/metrics_readout.py) group per CEO/thread without storing
# identity. Set to any random string in prod; empty falls back to a safe default.
NORA_METRICS_SALT=

# Real-time ops failure alert: when the pipeline fails, Nora emails this maintainer
# address (redacted — no email content). Empty disables it. Throttled to avoid alert
# storms when a dependency is down.
NORA_ALERT_EMAIL=
NORA_ALERT_THROTTLE_SECONDS=900

# CEO registry: JSON mapping of secret-address local-part -> allowed From address(es).
# A value may be a single address or a LIST of addresses for one person who forwards
# from several accounts. In production this lives in the secrets manager (KTD10/R7).
# Examples:
#   {"abc123hash": "ceo@example.com"}
#   {"nora": "ceo@example.com", "democeo": ["a@x.com", "b@y.com"]}
NORA_CEO_REGISTRY={}

# R1 self-serve onboarding (Phase 7). A prospective user emails signup@<domain>; DKIM proves
# they own that From; if their address/domain is on the allowlist below, Nora auto-provisions a
# private nora-<token>@<domain> address (stored in NORA_USERS_PATH) and replies with it. Empty
# allowlist (default) => signup OFF (no one is provisioned). Comma-separated or a JSON array;
# entries may be exact addresses, @domains, or bare domains.
#   NORA_SIGNUP_ALLOWLIST=@acme.com, founder@globex.com
NORA_SIGNUP_ALLOWLIST=
# NORA_SIGNUP_LOCAL=signup        # the public signup address local-part (default: signup)
# NORA_USERS_PATH=.nora-users.json  # dynamic registry file (runtime state; gitignored)

# Per-mailbox reply-From domain override (reply-as-client-domain). JSON mapping of a
# registry key -> the domain that mailbox's reply From uses, instead of
# NORA_ADDRESS_DOMAIN. The provider (Resend) MUST be verified for that domain (its
# DKIM/SPF DNS records on the client domain) or replies fail DMARC. Reply-To stays on
# NORA_ADDRESS_DOMAIN. Default {} => every mailbox replies from NORA_ADDRESS_DOMAIN.
# Example: {"nora.bennett": "example.nl"}  => replies from nora.bennett@example.nl
NORA_SENDER_DOMAIN_OVERRIDES={}
